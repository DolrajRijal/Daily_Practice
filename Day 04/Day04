    #prime check

def is_prime(n):
    if n<2:
        return False
    for i in range (2,n):
        if n%i == 0:
            return False
    return True
n = int(input("enter the number:"))
if is_prime(n):
    print(f"The entered number {n} is prime")
else:
    print(f"the entred number is not prime")



