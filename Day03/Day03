#probleem 2 celsius to farenheit conversion
num = int(input("enter the temperature in degree fahrenheit:"))
def fahrenheit_to_celsius(x):
    celsius = (x-32)*5/9
    return celsius;

celsius = fahrenheit_to_celsius(num)
print(f"{num} in fahrenheit is {celsius: .2f} in celsius")